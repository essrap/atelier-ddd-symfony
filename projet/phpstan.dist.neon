parameters:
    level: max
    paths:
        - bin/console
        - config/
        - public/
        - simulator/
        - src/
        - tests/
    excludePaths:
        # Generated by Symfony, not maintained by hand.
        - config/reference.php (?)
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
