{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"],
        // Mutation testing guards the domain only (ADR 0003): src/*/Domain.
        "excludes": ["/^(?!\\w+\\/Domain\\/)/"]
    },
    "logs": {
        "text": "var/infection.log"
    },
    "minMsi": 85,
    "minCoveredMsi": 85
}
